# ==========================================
# APP
# ==========================================
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ==========================================
# DATABASE (PostgreSQL)
# ==========================================
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tvhub?schema=public"
# Conexão direta, sem pooler. Em Neon/Supabase/PgBouncer é obrigatória para migrations.
# Em Postgres local, repita o mesmo valor de DATABASE_URL.
DIRECT_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tvhub?schema=public"

# ==========================================
# AUTH (Auth.js / NextAuth v5)
# ==========================================
# Gere com: openssl rand -base64 32
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# OAuth (opcional)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ==========================================
# REDIS — trava de 2 telas simultâneas
# ==========================================
REDIS_URL="redis://localhost:6379"

# ==========================================
# VOD / HLS
# ==========================================
# Bunny Stream
BUNNY_STREAM_API_KEY=""
BUNNY_STREAM_LIBRARY_ID=""
BUNNY_STREAM_CDN_HOSTNAME=""          # ex: vz-xxxxxxxx.b-cdn.net
# Chave de token authentication da library — assina as URLs .m3u8 com expiração
BUNNY_STREAM_TOKEN_KEY=""

# ==========================================
# PAGAMENTOS (PIX) — a definir
# ==========================================
# Provedor ainda não escolhido. Preencher quando o gateway PIX for contratado.
PAYMENT_GATEWAY="PIX_PROVIDER"
PAYMENT_API_KEY=""
PAYMENT_WEBHOOK_SECRET=""

# ==========================================
# SEED (desenvolvimento)
# ==========================================
SEED_ADMIN_EMAIL="admin@tvhub.com.br"
SEED_ADMIN_PASSWORD="admin123"

# ==========================================================
# SINCRONIZAÇÃO DA LISTA IPTV
# ==========================================================
# Chave do gatilho de /api/iptv/sync. OBRIGATÓRIA: sem ela a rota responde
# 503 e a sincronização automática não roda. Antes, a ausência desta
# variável deixava o endpoint aberto na internet — qualquer um podia
# disparar a reimportação de 150 mil canais.
# Gere com: openssl rand -hex 32
IPTV_SYNC_API_KEY=

# URL do EPG (XMLTV) da grade de programação. Opcional.
# Fontes: o XMLTV do próprio provedor, iptv-org/epg ou BrazilTVEPG.
EPG_XMLTV_URL=
