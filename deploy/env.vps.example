# Modelo do /opt/tvhub/.env — o arquivo de produção da VPS.
#
# ESTE ARQUIVO É UM MODELO. Os valores abaixo estão mascarados de propósito:
# só os primeiros e últimos caracteres aparecem, o suficiente para você
# conferir se a chave certa está no lugar certo sem que o valor real fique
# num arquivo versionado.
#
# O arquivo REAL vive apenas em /opt/tvhub/.env, na VPS, com chmod 600, e
# nunca entra no Git. O deploy o carrega com `set -a; . ./.env; set +a` antes
# de aplicar o tvhub-stack.yml.
#
# Por que isso importa: até pouco tempo estas três chaves eram valor padrão
# dentro do tvhub-stack.yml. Um repositório público por um instante bastaria
# para os bots de varredura colherem as três — e privar depois não desfaz,
# porque a chave já foi lida e continua no histórico e nos forks.
#
# Faltou alguma? O `docker stack deploy` aborta com a mensagem dizendo qual.
# Isso é intencional: é melhor o deploy falhar na hora do que subir com a
# variável vazia e alguém descobrir dias depois que a capa dos filmes parou
# de carregar.

# ==========================================================
# APLICAÇÃO
# ==========================================================
# Imagem que está em produção. O pipeline reescreve esta linha a cada deploy.
# É o único lugar do sistema que diz qual código está no ar.
TVHUB_IMAGE=ghcr.io/cineplayy2-wq/tvhub:sha-1234567

TVHUB_HOST=tvhub.exemplo.com.br
TVHUB_PUBLIC_URL=https://tvhub.exemplo.com.br

# ==========================================================
# BANCO E SESSÃO
# ==========================================================
# Senha do Postgres da stack. Gere com: openssl rand -base64 32
TVHUB_DB_PASSWORD=Xk2p****************************9Qm=

# Segredo do Auth.js. Trocar invalida a sessão de todo mundo.
# Gere com: openssl rand -base64 32
TVHUB_AUTH_SECRET=7fLa****************************c1R=

# ==========================================================
# SINCRONIZAÇÃO DA LISTA IPTV
# ==========================================================
# Sem ela a rota /api/iptv/sync responde 503 — de propósito: antes, a ausência
# da variável deixava o endpoint aberto para qualquer um na internet disparar
# a reimportação de 150 mil canais.
# Gere com: openssl rand -hex 32
TVHUB_SYNC_KEY=a91c****************************f30b

# URL do XMLTV (EPG) da grade. Opcional — também configurável pelo admin.
TVHUB_EPG_URL=

# ==========================================================
# TMDB — capas, sinopses e notas do catálogo
# ==========================================================
# Painel: https://www.themoviedb.org/settings/api
TMDB_API_KEY=45ae************************686f
TMDB_READ_TOKEN=eyJhbGciOiJIUzI1NiJ9.****************************.****e54

# ==========================================================
# DEEPSEEK — assistente de recomendação (/api/ai/assistant)
# ==========================================================
# Painel: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-0613************************fab8
DEEPSEEK_API_URL=https://api.deepseek.com/v1
